# Firecrawl API Key
# Get your API key from https://www.firecrawl.dev/app/
FIRECRAWL_API_KEY=your_api_key_here

# OpenRouter API Key
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Reducto API Key (Optional - for RAG document search)
# Get your API key from https://reducto.ai
REDUCTO_API_KEY=your_reducto_api_key_here

# MongoDB Configuration (for storing RAG chunks)
# Local MongoDB: mongodb://localhost:27017
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net
MONGODB_URI=mongodb://localhost:27017

# MongoDB Database Name
MONGODB_DB_NAME=zoning_rag
